# ============================================
# VIBE TECH SERVER — Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commit o arquivo .env no GitHub.

# Banco de Dados (PostgreSQL)
# No Railway: será preenchido automaticamente ao adicionar o plugin PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME"

# Porta do servidor (Railway define automaticamente)
PORT=3001

# E-mail (Gmail com App Password)
# Vá em: myaccount.google.com > Segurança > Verificação em 2 etapas > Senhas de app
SMTP_USER="seu-email@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
